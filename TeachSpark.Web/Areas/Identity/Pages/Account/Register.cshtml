@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="ts-auth row g-0">
    <div class="col-lg-5 d-none d-lg-block">
        <aside class="ts-auth-aside ts-cta-banner h-100">
            <span class="ts-label">Free to start</span>
            <h2 class="ts-section-title fs-1 mt-2 mb-3">Your classroom. Your voice. Faster prep.</h2>
            <ul class="ts-check-list">
                <li><i class="bi bi-check2"></i>Standards-aligned worksheets in under a minute</li>
                <li><i class="bi bi-check2"></i>Answer keys included</li>
                <li><i class="bi bi-check2"></i>Edit the prompts behind every template</li>
            </ul>
        </aside>
    </div>
    <div class="col-lg-7">
        <section class="ts-auth-form">
            <h1 class="ts-page-title">Create your account</h1>
            <p class="ts-page-subtitle mb-4">No credit card needed.</p>
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>
                <div class="ts-auth-links">
                    <p class="mb-0">
                        Already have an account?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                    </p>
                </div>
            </form>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="ts-auth-divider"><span>or</span></div>
                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="d-grid gap-2">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-secondary-mbs" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">Continue with @provider.DisplayName</button>
                        }
                    </div>
                </form>
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
