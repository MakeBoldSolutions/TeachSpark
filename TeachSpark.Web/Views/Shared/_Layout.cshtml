@inject TeachSpark.Web.IAssetsService AssetsService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    string NavActive(string controller, string? action = null) =>
        string.IsNullOrEmpty(currentArea)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewData["Description"] ?? "TeachSpark — AI-powered worksheet generator for teachers")" />
    <meta name="theme-color" content="#f8f6f2" />
    <title>@ViewData["Title"] - TeachSpark</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RY77Z11S9E"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-RY77Z11S9E');
    </script>
    <script type="importmap"></script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="@AssetsService.GetAssetPath("vendors.css")" />
    <link rel="stylesheet" href="@AssetsService.GetAssetPath("site.css")" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="visually-hidden-focusable btn btn-primary position-absolute m-2" style="z-index:2000" href="#main-content">Skip to content</a>
    <header class="navbar-ts">
        <nav class="navbar navbar-expand-lg p-0" aria-label="Main">
            <div class="container">
                <a class="ts-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="TeachSpark home">
                    <partial name="_BrandMark" model="@("ts-brand-mark text-dark")" />
                    <span class="ts-brand-text">
                        <span class="ts-brand-name">Teach<span>Spark</span></span>
                        <span class="ts-brand-sub">by Make Bold Spark</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("WorksheetGenerator")" asp-area="" asp-controller="WorksheetGenerator" asp-action="Index">
                                    <i class="bi bi-magic"></i> Generator
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Account", "Dashboard")" asp-area="" asp-controller="Account" asp-action="Dashboard">
                                    <i class="bi bi-grid-1x2"></i> Dashboard
                                </a>
                            </li>
                            @if (User.IsInRole(TeachSpark.Web.Services.AppRoles.Admin))
                            {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarAdminDropdown" role="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-sliders2"></i> Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarAdminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i>Admin dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Content</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="BloomLevels" asp-action="Index">
                                            <i class="bi bi-diagram-3 me-2"></i>Bloom levels
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="CommonCoreStandards" asp-action="Index">
                                            <i class="bi bi-bookmarks me-2"></i>Standards
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="WorksheetTemplates" asp-action="Index">
                                            <i class="bi bi-file-earmark-text me-2"></i>Templates
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Data</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Worksheets" asp-action="Index">
                                            <i class="bi bi-files me-2"></i>Worksheets
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="ApiKeys" asp-action="Index">
                                            <i class="bi bi-key me-2"></i>API keys
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            }
                        }
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home", "Plan")" asp-area="" asp-controller="Home" asp-action="Plan">
                                <i class="bi bi-signpost-split"></i> Roadmap
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="ts-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <a class="ts-brand ts-brand-on-dark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="TeachSpark home">
                        <partial name="_BrandMark" model="@("ts-brand-mark text-light")" />
                        <span class="ts-brand-text">
                            <span class="ts-brand-name">Teach<span>Spark</span></span>
                            <span class="ts-brand-sub">by Make Bold Spark</span>
                        </span>
                    </a>
                    <p class="footer-tagline">
                        Standards-aligned worksheets in seconds. Teachers stay in control of the AI.
                    </p>
                </div>
                <div class="col-6 col-lg-2 offset-lg-1">
                    <div class="footer-heading">Product</div>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="WorksheetGenerator" asp-action="Index">Generator</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Dashboard">Dashboard</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Plan">Roadmap</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-heading">Project</div>
                    <ul class="footer-links">
                        <li><a href="https://github.com/MakeBoldSolutions/TeachSpark" target="_blank" rel="noopener">GitHub</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-heading">Make Bold</div>
                    <ul class="footer-links">
                        <li><a href="https://makeboldspark.com" target="_blank" rel="noopener">Make Bold Spark</a></li>
                        <li><a href="https://makeboldsolutions.com" target="_blank" rel="noopener">Make Bold Solutions</a></li>
                        <li><a href="https://markhazleton.com" target="_blank" rel="noopener">Mark Hazleton</a></li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="d-flex flex-wrap justify-content-between gap-2 footer-meta">
                <span>&copy; @DateTime.Now.Year Make Bold Solutions &middot; TeachSpark</span>
                <span>Wichita, Kansas</span>
            </div>
        </div>
    </footer>

    <script src="@AssetsService.GetAssetPath("runtime.js")"></script>
    <script src="@AssetsService.GetAssetPath("jquery.js")"></script>
    <script src="@AssetsService.GetAssetPath("bootstrap.js")"></script>
    <script src="@AssetsService.GetAssetPath("vendors.js")"></script>
    <script src="@AssetsService.GetAssetPath("site.js")"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
