@{
    ViewData["Title"] = "Roadmap";
    ViewData["Description"] = "TeachSpark roadmap: what works today, what we're building next, and what comes later.";

    // Mirrors .devspark.work/roadmap/roadmap.md, the source of truth. When a roadmap item
    // changes status, update its entry here in the same pull request.
    const string RoadmapUpdated = "November 2026";

    var live = new[]
    {
        new { Icon = "bi-magic", Title = "AI worksheet generation", Desc = "Paste a passage and generate a worksheet in one of five English Language Arts formats. Choose a template, difficulty level, Bloom's level and number of questions, and add your own instructions." },
        new { Icon = "bi-bookmarks", Title = "Standards alignment", Desc = "Optionally align a worksheet to a grade 8 Common Core ELA standard and a Bloom's taxonomy level. More grades and subjects are next on the roadmap." },
        new { Icon = "bi-printer", Title = "Teacher and student views", Desc = "Review the worksheet with its answer key, switch to a student version without answers, and print from your browser." },
        new { Icon = "bi-person-check", Title = "Teacher accounts", Desc = "Free registration and sign-in, a personal dashboard and profile. Sign-ins last 14 days while you keep using the site." },
        new { Icon = "bi-shield-lock", Title = "Admin area", Desc = "Administrators manage standards, Bloom's levels, worksheet templates and their AI prompts, and review usage. Restricted to the Admin role." },
        new { Icon = "bi-graph-up", Title = "Usage tracking", Desc = "The model, tokens, cost and generation time of every worksheet are recorded, with structured logging of AI requests." },
    };

    var worksheetTypes = new[]
    {
        new { Icon = "bi-book", Label = "Reading comprehension", Detail = "Literal, inferential and text-evidence questions" },
        new { Icon = "bi-alphabet", Label = "Vocabulary", Detail = "Context clues, definitions and usage" },
        new { Icon = "bi-pencil-square", Label = "Grammar", Detail = "Rules and practice drawn from your text" },
        new { Icon = "bi-lightbulb", Label = "Creative writing", Detail = "Text-inspired prompts and planning" },
        new { Icon = "bi-search", Label = "Literary analysis", Detail = "Theme, character and craft" },
    };

    var phases = new[]
    {
        new
        {
            Key = "now", Label = "Now", Tone = "tone-rust", Badge = "badge-soft-rust",
            Title = "Foundation and trust",
            Intro = "Making TeachSpark safe and affordable to run before we add more features.",
            Items = new[]
            {
                new { Icon = "bi-speedometer", Title = "Fair-use and spending limits", Desc = "Daily limits on AI usage per teacher and overall, with a clear message when a limit is reached." },
                new { Icon = "bi-lock", Title = "Security hardening", Desc = "Require sign-in for the AI model endpoints and restrict diagnostics to administrators." },
                new { Icon = "bi-database-check", Title = "Safe upgrades for your data", Desc = "Database changes that apply automatically and keep your saved worksheets intact." },
                new { Icon = "bi-check2-all", Title = "Automated testing of generation", Desc = "Test the full worksheet flow on every change, without calling the AI service." },
            },
        },
        new
        {
            Key = "next", Label = "Next", Tone = "tone-ember", Badge = "badge-soft-ember",
            Title = "Core teacher value",
            Intro = "Finishing the loop from \"I need a worksheet\" to a printed page you can find again.",
            Items = new[]
            {
                new { Icon = "bi-collection", Title = "My worksheets", Desc = "Find, reopen, favourite and delete everything you've generated." },
                new { Icon = "bi-layers", Title = "Every grade and subject", Desc = "Pick your grade and subject. Common Core ELA and Math standards for every grade are already loaded." },
                new { Icon = "bi-shield-check", Title = "Student-safe content checks", Desc = "Check your source text and the AI's output for age-appropriate content and a complete structure." },
                new { Icon = "bi-pencil", Title = "Edit before you print", Desc = "Change any question or wording, with the AI's original kept so you can revert." },
                new { Icon = "bi-file-earmark-pdf", Title = "Classroom-ready PDF", Desc = "One-click PDF with consistent formatting and a separate answer key." },
                new { Icon = "bi-envelope-check", Title = "Email confirmation and password reset", Desc = "Verify your email address and recover a forgotten password." },
            },
        },
        new
        {
            Key = "later", Label = "Later", Tone = "tone-ink", Badge = "bg-secondary-subtle text-secondary-emphasis",
            Title = "Quality and differentiation",
            Intro = "Using your feedback to make every worksheet better.",
            Items = new[]
            {
                new { Icon = "bi-hand-thumbs-up", Title = "Ratings and feedback", Desc = "Tell us in one click whether a worksheet worked, so templates and prompts improve where it matters." },
                new { Icon = "bi-bar-chart-steps", Title = "Differentiated sets", Desc = "One request, matched worksheets at below, on and above grade level." },
                new { Icon = "bi-graph-up-arrow", Title = "Usage and quality insights", Desc = "See which worksheet types work best, and what each one costs to generate." },
            },
        },
        new
        {
            Key = "horizon", Label = "Horizon", Tone = "tone-ink", Badge = "bg-secondary-subtle text-secondary-emphasis",
            Title = "Classroom and reach",
            Intro = "Bigger ideas we'll take on once the core is solid.",
            Items = new[]
            {
                new { Icon = "bi-people", Title = "Class groups", Desc = "Organise worksheets by class with default grade and levels. TeachSpark will never store student data." },
                new { Icon = "bi-share", Title = "Shared worksheet library", Desc = "Publish your best worksheets and copy proven ones from other teachers." },
                new { Icon = "bi-code-slash", Title = "Public API", Desc = "Programmatic worksheet generation for integrations, using personal API keys." },
            },
        },
    };

    var upcomingCount = phases.Sum(p => p.Items.Length);
}

<!-- Page Header -->
<div class="ts-page-header">
    <div class="ts-page-header-content">
        <span class="ts-label mb-2">Roadmap · updated @RoadmapUpdated</span>
        <h1 class="ts-page-title">What works today, and what's next</h1>
        <p class="ts-page-subtitle">
            TeachSpark is an educational lab developed in the open. This page lists only what the app does today,
            and plans in the order we intend to build them. Nothing below "Live" is available yet.
        </p>
    </div>
</div>

<!-- Status Summary -->
<div class="row g-4 mb-5">
    <div class="col-6 col-lg-3">
        <div class="ts-card text-center p-4 h-100">
            <div class="ts-card-icon mx-auto mb-3 tone-positive"><i class="bi bi-check2-circle"></i></div>
            <div class="ts-stat-number fs-3 mb-1">@live.Length</div>
            <div class="text-muted small">Live today</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-card text-center p-4 h-100">
            <div class="ts-card-icon mx-auto mb-3 tone-ember"><i class="bi bi-ui-checks"></i></div>
            <div class="ts-stat-number fs-3 mb-1">@worksheetTypes.Length</div>
            <div class="text-muted small">Worksheet formats</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-card text-center p-4 h-100">
            <div class="ts-card-icon mx-auto mb-3 tone-rust"><i class="bi bi-map"></i></div>
            <div class="ts-stat-number fs-3 mb-1">@upcomingCount</div>
            <div class="text-muted small">Planned items</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ts-card text-center p-4 h-100">
            <div class="ts-card-icon mx-auto mb-3 tone-ink"><i class="bi bi-signpost-split"></i></div>
            <div class="ts-stat-number fs-3 mb-1">@phases.Length</div>
            <div class="text-muted small">Phases ahead</div>
        </div>
    </div>
</div>

<!-- Live -->
<section class="mb-5" aria-labelledby="live-heading">
    <div class="d-flex align-items-center gap-3 mb-4">
        <span class="badge badge-soft-positive">Live</span>
        <h2 id="live-heading" class="h4 mb-0 fw-bold">Available today</h2>
        <hr class="flex-grow-1 mb-0">
    </div>
    <div class="row g-4">
        @foreach (var item in live)
        {
            <div class="col-md-6 col-lg-4">
                <div class="ts-card h-100">
                    <div class="ts-card-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="ts-card-icon flex-shrink-0 tone-positive"><i class="bi @item.Icon"></i></div>
                            <h3 class="h6 fw-semibold mb-0">@item.Title</h3>
                        </div>
                        <p class="text-muted small mb-0">@item.Desc</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <h3 class="h6 fw-bold mt-5 mb-3">Worksheet formats</h3>
    <div class="row g-3">
        @foreach (var t in worksheetTypes)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="ts-type-tile h-100">
                    <span class="ts-type-icon"><i class="bi @t.Icon"></i></span>
                    <div>
                        <div class="ts-type-name">@t.Label</div>
                        <div class="ts-type-desc">@t.Detail</div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Planned phases -->
@foreach (var phase in phases)
{
    <section class="mb-5" aria-labelledby="@($"{phase.Key}-heading")">
        <div class="d-flex align-items-center gap-3 mb-2">
            <span class="badge @phase.Badge">@phase.Label</span>
            <h2 id="@($"{phase.Key}-heading")" class="h4 mb-0 fw-bold">@phase.Title</h2>
            <hr class="flex-grow-1 mb-0">
        </div>
        <p class="text-muted mb-4">@phase.Intro</p>
        <div class="row g-4">
            @foreach (var item in phase.Items)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="ts-card h-100">
                        <div class="ts-card-body">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="ts-card-icon flex-shrink-0 @phase.Tone"><i class="bi @item.Icon"></i></div>
                                <h3 class="h6 fw-semibold mb-0">@item.Title</h3>
                            </div>
                            <p class="text-muted small mb-0">@item.Desc</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Built on -->
<section class="mb-5" aria-labelledby="stack-heading">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 id="stack-heading" class="h4 mb-0 fw-bold">Built on</h2>
        <hr class="flex-grow-1 mb-0">
    </div>
    @{
        var stackItems = new[]
        {
            new { Layer = "Platform", Items = new[] { ".NET 10 and ASP.NET Core MVC", "Entity Framework Core", "SQLite" } },
            new { Layer = "Frontend", Items = new[] { "Bootstrap 5 and Bootstrap Icons", "Webpack 5 asset pipeline", "Make Bold design system" } },
            new { Layer = "AI", Items = new[] { "Microsoft.Extensions.AI", "OpenAI, GPT-4o-mini by default", "Cost and token tracking" } },
            new { Layer = "Accounts", Items = new[] { "ASP.NET Core Identity", "Cookie sign-in, 14-day sliding", "Role-based admin area" } },
        };
    }
    <div class="row g-3">
        @foreach (var s in stackItems)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="ts-card h-100">
                    <div class="ts-card-body">
                        <h3 class="h6 fw-bold mb-3">@s.Layer</h3>
                        <ul class="list-unstyled mb-0">
                            @foreach (var entry in s.Items)
                            {
                                <li class="d-flex align-items-start gap-2 mb-2 small text-muted">
                                    <i class="bi bi-check2 mt-1 flex-shrink-0"></i>@entry
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Feedback CTA -->
<div class="ts-hero-section">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="ts-label mb-2">Educational lab</span>
            <h2 class="h3 text-white fw-bold mb-3">Help us set the order</h2>
            <p class="mb-4" style="max-width:580px;">
                This plan changes as we learn what teachers need most. If something here matters to your classroom,
                or something is missing, tell us on GitHub.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-area="" asp-controller="WorksheetGenerator" asp-action="Index" class="btn btn-light fw-semibold px-4">
                    <i class="bi bi-magic me-2"></i>Try the generator
                </a>
                <a href="https://github.com/MakeBoldSolutions/TeachSpark/issues" target="_blank" rel="noopener" class="btn btn-outline-light fw-semibold px-4">
                    <i class="bi bi-github me-2"></i>Share an idea
                </a>
            </div>
        </div>
    </div>
</div>
